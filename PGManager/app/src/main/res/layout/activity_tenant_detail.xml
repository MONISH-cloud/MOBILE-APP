<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gradient_bg"
            android:padding="@dimen/spacing_lg">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Back"
                android:padding="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/btnBack"
                android:layout_marginTop="@dimen/spacing_md"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAvatar"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/circle_avatar_bg"
                    android:gravity="center"
                    android:text="T"
                    android:textColor="@color/white"
                    android:textSize="32sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_title"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/status_badge"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="Active"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Details Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_md"
            style="@style/Widget.PGManager.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tenant Details"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_subtitle"
                    android:fontFamily="sans-serif-bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:background="@color/divider" />

                <!-- Phone -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="📞 Phone" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/tvPhone" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:textColor="@color/text_primary" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- PG -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🏠 PG" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/tvPGName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:textColor="@color/text_primary" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- Room -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🚪 Room" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/tvRoom" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:textColor="@color/accent" android:textSize="13sp" android:fontFamily="sans-serif-bold" />
                </LinearLayout>

                <!-- Bed -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🛏️ Bed" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/tvBed" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:textColor="@color/accent" android:textSize="13sp" android:fontFamily="sans-serif-bold" />
                </LinearLayout>

                <!-- Rent -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="💰 Rent" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/tvRent" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:textColor="@color/text_primary" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- Joined -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="📅 Joined" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/tvJoined" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:textColor="@color/text_primary" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- Rewards removed -->

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Action Buttons Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWhatsApp"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="WhatsApp"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:backgroundTint="@color/whatsapp_green"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="✏️ Edit"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:backgroundTint="@color/primary_variant"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNotice"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="⚠️ Notice"
                android:textColor="@color/status_notice"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:backgroundTint="@color/surface_variant"
                app:strokeColor="@color/status_notice"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- Action Buttons Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeRoom"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="🔄 Change Room"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:backgroundTint="@color/surface_variant"
                app:strokeColor="@color/accent"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteTenant"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="🗑️ Delete"
                android:textColor="@color/danger"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:backgroundTint="@color/surface_variant"
                app:strokeColor="@color/danger"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- Notice Countdown -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_md"
            android:visibility="gone"
            style="@style/Widget.PGManager.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/status_notice_bg"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏳ Notice Period Active"
                    android:textColor="@color/status_notice"
                    android:textSize="@dimen/text_subtitle"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:id="@+id/tvCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textColor="@color/text_primary"
                    android:textSize="36sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:id="@+id/tvMoveOutDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCompleteMoveOut"
                    style="@style/Widget.PGManager.Button.Danger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/complete_moveout" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Rent History -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/rent_history"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_subtitle"
            android:fontFamily="sans-serif-bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRentHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:clipToPadding="false"
            android:padding="@dimen/spacing_md" />

        <View android:layout_width="match_parent" android:layout_height="80dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
