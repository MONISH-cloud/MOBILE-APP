<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background">

        <!-- ── HEADER ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gradient_bg"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="52dp"
            android:paddingBottom="16dp">

            <!-- Welcome row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvWelcome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hi there 👋"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Find your perfect PG"
                        android:textColor="#CCE3F2FF"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Logout"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#33FFFFFF"
                    app:cornerRadius="10dp" />
            </LinearLayout>

            <!-- Tab buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabBrowse"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="🔍 Browse PGs"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/primary"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabMyPG"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="🏠 My PG"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/surface_variant"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── BROWSE TAB ── -->
        <LinearLayout
            android:id="@+id/layoutBrowse"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Search Bar -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="12dp"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="@color/divider"
                app:hintTextColor="@color/text_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="🔍  Search by name or area..."
                    android:inputType="text"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Count -->
            <TextView
                android:id="@+id/tvPGCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:paddingStart="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="4dp" />

            <!-- Progress -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />

            <!-- Empty State -->
            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No PGs available right now.\nCheck back later!"
                android:textColor="@color/text_hint"
                android:textSize="15sp"
                android:paddingTop="48dp"
                android:visibility="gone" />

            <!-- PG List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPGs"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="16dp" />
        </LinearLayout>

        <!-- ── MY PG TAB ── -->
        <ScrollView
            android:id="@+id/layoutMyPG"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- No PG state -->
                <LinearLayout
                    android:id="@+id/layoutNoMyPG"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="48dp"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏠"
                        android:textSize="48sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="You're not linked to any PG yet"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Ask your PG owner to add you as a tenant.\nYour details will appear here automatically."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- My PG Details Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardMyPGDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/card_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Card header gradient -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/gradient_bg"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MY CURRENT PG"
                                android:textColor="#99FFFFFF"
                                android:textSize="10sp"
                                android:fontFamily="sans-serif-black"
                                android:letterSpacing="0.12" />

                            <TextView
                                android:id="@+id/tvMyPGName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="PG Name"
                                android:textColor="@color/white"
                                android:textSize="22sp"
                                android:fontFamily="sans-serif-bold" />

                            <TextView
                                android:id="@+id/tvMyStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="ACTIVE"
                                android:textColor="@color/accent"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-bold" />
                        </LinearLayout>

                        <!-- Details -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <!-- Room & Bed -->
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🚪 Room / Bed" android:textColor="@color/text_secondary" android:textSize="13sp" />
                                <TextView android:id="@+id/tvMyRoom" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:textColor="@color/text_primary" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
                            </LinearLayout>

                            <!-- Rent -->
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="💰 Monthly Rent" android:textColor="@color/text_secondary" android:textSize="13sp" />
                                <TextView android:id="@+id/tvMyRent" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:textColor="@color/primary" android:textSize="13sp" android:fontFamily="sans-serif-bold" />
                            </LinearLayout>

                            <!-- Joined -->
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="📅 Joined" android:textColor="@color/text_secondary" android:textSize="13sp" />
                                <TextView android:id="@+id/tvMyJoined" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:textColor="@color/text_primary" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
                            </LinearLayout>

                            <!-- Rent Status -->
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="📋 Rent Status" android:textColor="@color/text_secondary" android:textSize="13sp" />
                                <TextView android:id="@+id/tvMyRentStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:textColor="@color/accent" android:textSize="13sp" android:fontFamily="sans-serif-bold" />
                            </LinearLayout>

                            <!-- View on Map -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMyPGMap"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="42dp"
                                android:layout_marginBottom="16dp"
                                android:text="🗺️ View PG Location on Map"
                                android:textColor="@color/primary"
                                android:textSize="13sp"
                                android:textAllCaps="false"
                                app:cornerRadius="12dp"
                                app:strokeColor="@color/primary"
                                xmlns:app="http://schemas.android.com/apk/res-auto" />

                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginBottom="16dp" />

                            <!-- Owner info -->
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OWNER CONTACT" android:textColor="@color/text_hint" android:textSize="10sp" android:fontFamily="sans-serif-black" android:letterSpacing="0.12" android:layout_marginBottom="10dp" />

                            <TextView android:id="@+id/tvMyOwnerName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
                            <TextView android:id="@+id/tvMyOwnerPhone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginTop="2dp" android:layout_marginBottom="14dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnContactOwner"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:text="💬 Chat with Owner on WhatsApp"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textAllCaps="false"
                                android:backgroundTint="@color/whatsapp_green"
                                android:visibility="gone"
                                app:cornerRadius="14dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRaiseRequest"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="10dp"
                                android:text="🔧 Raise Maintenance Request"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textAllCaps="false"
                                android:backgroundTint="@color/primary"
                                android:visibility="gone"
                                app:cornerRadius="14dp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- My Requests Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardMyRequests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:visibility="gone"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/card_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MY REQUESTS"
                            android:textColor="@color/text_hint"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.12"
                            android:layout_marginBottom="10dp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvMyRequests"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />

                        <TextView
                            android:id="@+id/tvNoRequests"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="No requests raised yet"
                            android:textColor="@color/text_hint"
                            android:textSize="13sp"
                            android:paddingTop="12dp"
                            android:paddingBottom="4dp"
                            android:visibility="visible" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
