<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".PGManagerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PGManager"
        tools:targetApi="34">

        <!-- Auth Screens -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.PGManager.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main App -->
        <activity
            android:name=".ui.main.MainActivity"
            android:theme="@style/Theme.PGManager.NoActionBar" />

        <!-- PG Module -->
        <activity android:name=".ui.pg.AddEditPGActivity"
            android:theme="@style/Theme.PGManager.NoActionBar" />
        <activity android:name=".ui.pg.PGDetailActivity"
            android:theme="@style/Theme.PGManager.NoActionBar" />

        <!-- Room Module -->
        <activity android:name=".ui.room.RoomBedActivity"
            android:theme="@style/Theme.PGManager.NoActionBar" />

        <!-- Tenant Module -->
        <activity android:name=".ui.tenant.AddEditTenantActivity"
            android:theme="@style/Theme.PGManager.NoActionBar" />
        <activity android:name=".ui.tenant.TenantDetailActivity"
            android:theme="@style/Theme.PGManager.NoActionBar" />

        <!-- Expense Module -->
        <activity android:name=".ui.expense.AddExpenseActivity"
            android:theme="@style/Theme.PGManager.NoActionBar" />

        <!-- Chatbot -->
        <activity android:name=".ui.chat.ChatbotActivity"
            android:theme="@style/Theme.PGManager.NoActionBar" />

        <!-- New Screens -->
        <activity android:name=".ui.whatsapp.WhatsAppHubActivity"
            android:theme="@style/Theme.PGManager.NoActionBar" />
        <activity android:name=".ui.complaints.ComplaintsActivity"
            android:theme="@style/Theme.PGManager.NoActionBar" />
        <activity android:name=".ui.notifications.NotificationsActivity"
            android:theme="@style/Theme.PGManager.NoActionBar" />
        <activity android:name=".ui.tenant_portal.TenantPortalActivity"
            android:theme="@style/Theme.PGManager.NoActionBar" />

    </application>

</manifest>
